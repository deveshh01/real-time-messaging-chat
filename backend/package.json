{
  "name": "realtime-chat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend — Socket.IO + REST API + Prisma + PostgreSQL",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:load": "tsx prisma/seedLoad.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "cookie": "^0.6.0",
    "file-type": "^19.6.0",
    "jose": "^5.9.6",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "nsfwjs": "^4.2.1"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/node": "^20.16.11",
    "cross-env": "^7.0.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
